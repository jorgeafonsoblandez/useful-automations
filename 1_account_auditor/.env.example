# Your email address (e.g., your.name@gmail.com)
EMAIL_ACCOUNT=your_email_here

# Your App Password (not your main password)
# For Gmail: Manage your Google Account -> Security -> 2-Step Verification -> App Passwords
APP_PASSWORD=your_16_char_app_password_here

# Optional: Gemini API Key to generate the nice HTML report
# Get a free key here: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_key_here
